<footer class="wgSiteFooter">
    <div class="wgPage wgSiteFooterInner">
        <div>
            <p class="wgSiteFooterMark">WAYMARK <span>GEAR</span></p>
            <p>waymarkgear.com · Based on <a href="{{chrome.upstream.url}}" target="_blank" rel="noopener noreferrer">{{chrome.upstream.name}}</a> by {{chrome.upstream.author}}</p>
            {{#chrome.social.length}}
            <div class="wgSiteFooterSocial" data-testid="footer-social">
                <span>Find us</span>
                <ul>
                    {{#chrome.social}}
                    <li><a href="{{url}}" target="_blank" rel="noopener noreferrer me" aria-label="{{label}}" title="{{name}}" data-testid="footer-social-link">{{{svg}}}</a></li>
                    {{/chrome.social}}
                </ul>
            </div>
            {{/chrome.social.length}}
        </div>
        <nav class="wgSiteFooterLinks" aria-label="Footer">
            <a href="/explore">Explore gear</a>
            <a href="/kits">Kits</a>
            <a href="/supporter" data-testid="footer-supporter">Support Waymark</a>
            <a href="/developers">API and AI</a>
            <a href="/report" data-testid="footer-report">Report a problem</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <button type="button" class="wgCookieSettings" data-cookie-settings>Cookie settings</button>
            <a href="{{chrome.sourceUrl}}" target="_blank" rel="noopener noreferrer">Source</a>
            {{#chrome.contactEmail}}<a href="mailto:{{chrome.contactEmail}}">Contact</a>{{/chrome.contactEmail}}
        </nav>
    </div>
</footer>
