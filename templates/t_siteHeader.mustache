<header class="wgSiteHeader" data-site-header>
    <a class="wgSkipLink" href="#wgMain" data-skip-link>{{#t}}header.skipToContent{{/t}}</a>
    <div class="wgSiteHeaderInner wgPage">
        <a href="/" class="wgSiteHeaderLogo" data-logo-home aria-label="{{#t}}header.home{{/t}}" data-testid="site-logo">
            <span class="wgBrandLogo">
                <img class="wgLogo wgLogoOnLight" src="/images/waymark-logo.png" alt="Waymark Gear" width="843" height="127">
                <img class="wgLogo wgLogoOnDark" src="/images/waymark-logo-light.png" alt="Waymark Gear" width="843" height="127">
            </span>
        </a>
        <nav id="wgSiteNav" class="wgSiteNav" aria-label="{{#t}}header.mainNav{{/t}}">
            {{#chrome.menu}}
            {{#isGroup}}
            <div class="wgNavGroup" data-show="{{show}}" {{#gated}}hidden{{/gated}}>
                <button type="button" class="wgSiteNavLink wgNavGroupBtn{{#active}} wgActive{{/active}}" aria-expanded="false" aria-controls="wgNavDrop-{{id}}" data-testid="nav-{{id}}">{{label}}<svg class="wgNavCaret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
                <div id="wgNavDrop-{{id}}" class="wgNavDrop" role="group" aria-label="{{label}}">
                    <span class="wgNavDropLabel">{{label}}</span>
                    {{#items}}
                    <a href="{{href}}" class="wgNavDropItem" data-show="{{show}}" {{#gated}}hidden{{/gated}} data-testid="nav-{{id}}"><span class="wgNavDropTitle">{{label}}</span>{{#note}}<span class="wgNavDropNote">{{note}}</span>{{/note}}</a>
                    {{/items}}
                </div>
            </div>
            {{/isGroup}}
            {{^isGroup}}
            <a href="{{href}}" class="wgSiteNavLink{{#active}} wgActive{{/active}}" data-show="{{show}}" {{#gated}}hidden{{/gated}} data-testid="nav-{{id}}">{{label}}</a>
            {{/isGroup}}
            {{/chrome.menu}}
            <div class="wgSiteNavPhoneGroup">
                {{#chrome.extras}}
                <a href="{{href}}" class="wgSiteNavLink wgSiteNavPhone" data-show="{{show}}" {{#gated}}hidden{{/gated}} data-testid="{{testid}}">{{label}}</a>
                {{/chrome.extras}}
            </div>
        </nav>
        <div class="wgSiteHeaderActions">
            <a href="/signin" class="wgBtn wgBtnGhost wgHideOnPhone" data-show="guest" data-testid="header-signin">{{#t}}header.signIn{{/t}}</a>
            {{#signupCta}}<a href="/register" class="wgBtn wgBtnPrimary wgBtnEmber" data-show="guest" data-testid="header-signup">{{signupCta}}</a>{{/signupCta}}{{^signupCta}}<a href="/?start=1" class="wgBtn wgBtnPrimary" data-show="guest" data-testid="header-lists" data-lists-button><span class="wgLong">{{chrome.cta}}</span><span class="wgShort">{{chrome.ctaShort}}</span></a>{{/signupCta}}
            <!-- Signed in: notifications and the account menu, as in the app. -->
            <a href="/notifications" class="wgHeaderBell" data-show="signedIn" hidden aria-label="{{#t}}header.notifications{{/t}}" data-testid="notification-bell">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0" /></svg>
                <span class="wgHeaderBellCount" data-bell-count hidden></span>
            </a>
            <div class="wgHeaderAccount wgAvatarMenu" data-show="signedIn" hidden>
                <button type="button" class="lpAvatar" aria-haspopup="true" aria-expanded="false" data-testid="account-menu" data-viewer-initial></button>
                <nav class="wgAvatarMenuList" aria-label="{{#t}}header.account{{/t}}" hidden>
                    <p class="wgAvatarMenuUser">{{#t}}header.signedInAs{{/t}} <strong data-viewer-name></strong></p>
                    <a href="/" data-testid="menu-lists">{{#t}}header.myLists{{/t}}</a>
                    <a href="/profile">{{#t}}header.yourProfile{{/t}}</a>
                    <a href="/trips">{{#t}}header.tripJournals{{/t}}</a>
                    <a href="/notifications">{{#t}}header.notifications{{/t}}</a>
                    <a href="/developers">{{#t}}header.developers{{/t}}</a>
                    <a href="/supporter">{{#t}}header.support{{/t}}</a>
                    <button type="button" class="wgAvatarSignout" data-signout>{{#t}}header.signOut{{/t}}</button>
                </nav>
            </div>
        </div>
        <button type="button" class="wgSiteMenuBtn" aria-expanded="false" aria-controls="wgSiteNav" aria-label="{{#t}}header.menu{{/t}}" data-testid="site-menu">
            <svg class="wgMenuIconOpen" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="wgMenuIconClose" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
    </div>
</header>
