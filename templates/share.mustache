<!DOCTYPE html>
<html class="lp" lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{listName}} by @{{username}} — Waymark Gear</title>
        <meta name="description" content="{{metaDescription}}">
        <link rel="canonical" href="{{deployUrl}}/r/{{externalId}}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Waymark Gear">
        <meta property="og:title" content="{{listName}} · {{baseWeight}} base weight">
        <meta property="og:description" content="{{metaDescription}}">
        <meta property="og:url" content="{{deployUrl}}/r/{{externalId}}">
        <meta property="og:image" content="{{{ogImage}}}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{listName}}: {{baseWeight}} base weight, by @{{username}}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:image" content="{{{ogImage}}}">
        {{{styles}}}
        <link rel="icon" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
        <style>.lpModalOverlay, #lpImageDialog { display: none;}</style>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <!-- The bundle is a module at the end of the body, so it runs after
             first paint. A stored theme has to land on <html> before then, or
             a reader who picked dark against a light OS watches the page flip.
             Only an explicit choice is applied; with none stored the media
             query in _base.scss is already correct. initTheme() re-applies
             this and adds the OS listener once the bundle runs. -->
        <script nonce="{{{cspNonce}}}">
            (function () {
                try {
                    var t = localStorage.getItem('lpTheme');
                    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
                } catch (e) { /* storage blocked; fall through to the media query */ }
            }());
        </script>
    </head>
    <body>
        {{> siteHeader}}
        <main id="main" class="lpShare">
            <div id="wgMain" tabindex="-1"></div>
            <div class="lpList {{#optionalFields.images}}lpShowImages{{/optionalFields.images}} {{#optionalFields.worn}}lpShowWorn{{/optionalFields.worn}} {{#optionalFields.consumable}}lpShowConsumable{{/optionalFields.consumable}} {{#optionalFields.price}}lpShowPrices{{/optionalFields.price}}">
                <div class="lpShareHeader">
                    <div class="wgShareTitle">
                        <h1 class="lpListName">{{listName}}</h1>
                        <p class="wgShareByline">by <a href="/@{{username}}" class="wgShareProfileLink" data-testid="share-profile-link"><strong>@{{username}}</strong></a> · {{baseWeight}} base weight · {{itemCount}} items{{#weightClass}} · <span class="wgBadge">{{weightClass}}</span>{{/weightClass}}{{#tripTypeLabel}} · <span class="wgBadge" data-testid="share-trip-type">{{tripTypeLabel}}</span>{{/tripTypeLabel}}{{#trailLabel}} · {{#trailSlug}}<a href="/trails/{{trailSlug}}" class="wgBadge wgBadgeTrail" data-testid="share-trail">{{trailLabel}}</a>{{/trailSlug}}{{^trailSlug}}<span class="wgBadge">{{trailLabel}}</span>{{/trailSlug}}{{/trailLabel}}</p>
                        <div class="wgShareSocial">
                            {{#published}}<span id="wgVotes" class="wgVotes" data-external-id="{{externalId}}" aria-label="Votes"></span>{{/published}}
                            <span class="wgFollow" data-follow-user="{{username}}"></span>
                            <a href="/?copy={{externalId}}" class="wgBtn wgBtnPrimary wgBtnSmall wgShareCopy" data-testid="copy-list">Copy to my lists</a>
                        </div>
                        {{#shakedown}}<p class="wgShakedownBanner" data-testid="shakedown-banner"><strong>Shakedown requested.</strong> @{{username}} would like suggestions: what to cut, swap or rethink. <a href="#wgComments">Leave one below</a>.</p>{{/shakedown}}
                    </div>
                    <div class="lpShareMenu">
                        <button type="button" class="lpShareMenuTarget" data-testid="share-settings" aria-label="Page settings" aria-expanded="false" aria-controls="lpShareMenuContent">
                            <i class="lpSprite lpSettings"></i>
                        </button>
                        <div class="lpShareMenuContent" id="lpShareMenuContent">
                            <label class="lpToggle">
                                <input type="checkbox" class="lpToggleControl" id="lpThemeToggle" data-testid="dark-mode-toggle">
                                <span class="lpToggleText">Dark mode</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="lpListSummary">
                    <div class="lpChartContainer">
                        <div class="lpChartStage" data-testid="chart"></div>
                        <div class="wgChartStyles" role="group" aria-label="Chart style" data-chart-styles>
                            <button type="button" class="wgChartStyle" data-style="donut" data-testid="chart-style-donut" aria-pressed="true">Donut</button>
                            <button type="button" class="wgChartStyle" data-style="bars" data-testid="chart-style-bars" aria-pressed="false">Bars</button>
                            <button type="button" class="wgChartStyle" data-style="treemap" data-testid="chart-style-treemap" aria-pressed="false">Treemap</button>
                        </div>
                    </div>
                    <div class="lpTotalsContainer">
                        {{{renderedTotals}}}
                    </div>
                </div>

                <div style="clear:both"></div>

                {{#renderedDescription}}
                    <div id="lpListDescription">
                        {{{renderedDescription}}}
                    </div>
                {{/renderedDescription}}

                <ul class="lpCategories">{{{renderedCategories}}}</ul>
                <p class="wgReportLink"><a href="/report?kind=list&amp;url=%2Fr%2F{{externalId}}" data-testid="report-list">Report a problem with this list</a></p>
                <p class="wgReportLink wgDisclosure">Links to catalog gear may earn Waymark Gear a commission, which pays for the site. <a href="/supporter">Supporters</a> get plain links.</p>
                {{#published}}
                <section id="wgComments" class="wgComments" data-external-id="{{externalId}}" aria-labelledby="wgCommentsTitle">
                    <h2 id="wgCommentsTitle">{{#shakedown}}Shakedown{{/shakedown}}{{^shakedown}}Comments{{/shakedown}}</h2>
                    <noscript><p>Turn on JavaScript to read and write comments.</p></noscript>
                </section>
                {{/published}}
            </div>
        </main>
        <div class="lpDialog" id="lpImageDialog"></div>
        <div class="lpModalOverlay"></div>
        {{{scripts}}}
        {{> siteFooter}}
        <script nonce="{{{cspNonce}}}">chartData="{{{chartData}}}";</script>
    </body>
</html>