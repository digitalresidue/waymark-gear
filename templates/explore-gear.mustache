<!DOCTYPE html>
<html class="lp" lang="en">
    <head>
        <meta charset="utf-8">
        <title>{{pageTitle}} — Waymark Gear</title>
        <meta name="description" content="{{metaDescription}}">
        <link rel="canonical" href="{{deployUrl}}{{canonicalPath}}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Waymark Gear">
        <meta property="og:title" content="{{pageTitle}}">
        <meta property="og:description" content="{{metaDescription}}">
        <meta property="og:url" content="{{deployUrl}}{{canonicalPath}}">
        {{{styles}}}
        <link rel="icon" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <script nonce="{{{cspNonce}}}">
            (function () {
                try {
                    var t = localStorage.getItem('lpTheme');
                    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
                } catch (e) { /* storage blocked; the media query decides */ }
            }());
        </script>
    </head>
    <body class="wgProfilePage wgExploreGearPage">
        {{> siteHeader}}

        <main id="wgMain" tabindex="-1" class="wgPage wgExploreGear">
            {{#index}}
            <p class="wgTrailKicker">{{#t}}explore.kicker{{/t}}</p>
            <h1 class="wgH2">{{#t}}explore.title{{/t}}</h1>
            <p class="wgLede">{{#t}}explore.lede{{/t}} <a href="/kits">{{#t}}explore.exploreKits{{/t}}</a></p>

            <ul class="wgExploreParents" data-testid="explore-parents">
                {{#parents}}
                <li class="wgCard wgExploreParent" data-testid="explore-section" data-slug="{{slug}}">
                    <a class="wgExploreParentLink" href="/explore/{{slug}}">
                        <h2>{{name}}</h2>
                        <span class="wgMuted">{{note}}</span>
                        <span class="wgExploreCount">{{countLabel}}</span>
                    </a>
                    {{#children.length}}
                    <ul class="wgExploreChildren">
                        {{#children}}<li><a href="{{href}}" data-testid="explore-child">{{name}} <span class="wgMuted">{{count}}</span></a></li>{{/children}}
                    </ul>
                    {{/children.length}}
                </li>
                {{/parents}}
            </ul>

            {{#others.length}}
            <h2 class="wgProfileSection">{{#t}}explore.everythingElse{{/t}}</h2>
            <ul class="wgExploreOthers" data-testid="explore-others">
                {{#others}}
                <li><a class="wgCard" href="/explore/{{slug}}" data-testid="explore-section" data-slug="{{slug}}"><span>{{name}}</span> <span class="wgMuted">{{count}}</span></a></li>
                {{/others}}
            </ul>
            {{/others.length}}
            {{/index}}

            {{#section}}
            <nav class="wgCrumbs" aria-label="{{#t}}explore.breadcrumb{{/t}}">
                <a href="/explore">{{#t}}explore.title{{/t}}</a>{{#parent}} › <a href="/explore/{{slug}}">{{name}}</a>{{/parent}} › <span aria-current="page">{{title}}</span>
            </nav>
            <h1 class="wgH2" data-testid="explore-title">{{title}}</h1>
            {{#note}}<p class="wgLede">{{note}}</p>{{/note}}
            {{#subtypes}}
            <nav class="wgExploreSubtypes" aria-label="{{label}}" data-subtypes="{{key}}" data-testid="explore-subtypes">
                <a href="{{all.href}}" class="wgSubtype" data-subtype="" {{#all.on}}aria-current="true"{{/all.on}} data-testid="subtype-all">{{all.name}} <span class="wgMuted">{{all.count}}</span></a>
                {{#options}}<a href="{{href}}" class="wgSubtype" data-subtype="{{value}}" {{#on}}aria-current="true"{{/on}} data-testid="subtype-{{value}}">{{name}} <span class="wgMuted">{{count}}</span></a>{{/options}}
            </nav>
            {{/subtypes}}

            <div class="wgExploreLayout">
                <details class="wgFiltersBox" open data-testid="explore-filters-box">
                    <summary class="wgFiltersToggle">{{#t}}explore.filters{{/t}} <span data-filter-count>{{activeLabel}}</span></summary>
                    <form id="wgGearFilters" class="wgFilters" method="get" action="/explore/{{slug}}" data-slug="{{slug}}" data-testid="explore-filters">
                        {{! Each filter folds, so the column stays short: closed until
                            opened, or while it has a choice made. Its heading says
                            what's chosen (a slider's range, how many are ticked). }}
                        {{#facets.cats.length}}
                        <details class="wgFilter" data-filter-fold data-testid="filter-cat" {{#facets.catsOpen}}open{{/facets.catsOpen}}>
                            <summary class="wgFilterSummary"><span class="wgFilterLabel">{{#t}}explore.category{{/t}}</span><span class="wgFilterPicked" data-picked></span></summary>
                            <fieldset class="wgFilterBody">
                                <legend class="wgFilterHidden">{{#t}}explore.category{{/t}}</legend>
                                {{#facets.cats}}<label class="wgFilterCheck"><input type="checkbox" name="cat" value="{{value}}" {{#on}}checked{{/on}}> {{label}} <span class="wgMuted">{{count}}</span></label>{{/facets.cats}}
                            </fieldset>
                        </details>
                        {{/facets.cats.length}}

                        {{#facets.brands.length}}
                        <details class="wgFilter" data-filter-fold data-testid="filter-brand" {{#facets.brandsOpen}}open{{/facets.brandsOpen}}>
                            <summary class="wgFilterSummary"><span class="wgFilterLabel">{{#t}}explore.brand{{/t}}</span><span class="wgFilterPicked" data-picked></span></summary>
                            <fieldset class="wgFilterBody">
                                <legend class="wgFilterHidden">{{#t}}explore.brand{{/t}}</legend>
                                {{#facets.brands}}<label class="wgFilterCheck" data-brand-option="{{value}}" {{#hidden}}hidden{{/hidden}}><input type="checkbox" name="brand" value="{{value}}" {{#on}}checked{{/on}}> {{label}} <span class="wgMuted" data-brand-count>{{count}}</span></label>{{/facets.brands}}
                            </fieldset>
                        </details>
                        {{/facets.brands.length}}

                        {{#blocks}}
                        {{#range}}
                        <details class="wgFilter wgRange" data-filter-fold data-range="{{key}}" data-spec-types="{{types}}" {{#hidden}}hidden{{/hidden}} {{#open}}open{{/open}} data-min="{{min}}" data-max="{{max}}" data-step="{{step}}" {{#stops}}data-stops="{{stops}}"{{/stops}} data-testid="range-{{key}}">
                            <summary class="wgFilterSummary wgRangeHead"><span class="wgFilterLabel">{{label}}{{#appliesTo}}<span class="wgFilterFor"> · {{appliesTo}}</span>{{/appliesTo}}</span><output data-out>{{text}}</output></summary>
                            <div class="wgRangeTrack">
                                <input type="range" class="wgRangeLo" name="{{key}}_min" min="{{min}}" max="{{max}}" step="{{step}}" value="{{lo}}" aria-label="{{ariaMin}}" data-testid="range-{{key}}-min">
                                <input type="range" class="wgRangeHi" name="{{key}}_max" min="{{min}}" max="{{max}}" step="{{step}}" value="{{hi}}" aria-label="{{ariaMax}}" data-testid="range-{{key}}-max">
                            </div>
                        </details>
                        {{/range}}
                        {{#match}}
                        <details class="wgFilter" data-filter-fold data-testid="filter-{{key}}" data-spec-types="{{types}}" {{#hidden}}hidden{{/hidden}} {{#open}}open{{/open}}>
                            <summary class="wgFilterSummary"><span class="wgFilterLabel">{{label}}{{#appliesTo}}<span class="wgFilterFor"> · {{appliesTo}}</span>{{/appliesTo}}</span><span class="wgFilterPicked" data-picked></span></summary>
                            <fieldset class="wgFilterBody">
                                <legend class="wgFilterHidden">{{label}}</legend>
                                {{#options}}<label class="wgFilterCheck{{#off}} wgFilterOff{{/off}}"><input type="checkbox" name="{{key}}" value="{{value}}" {{#on}}checked{{/on}} {{#off}}disabled{{/off}}> {{label}} <span class="wgMuted">{{count}}</span></label>{{/options}}
                            </fieldset>
                        </details>
                        {{/match}}
                        {{/blocks}}


                        <input type="hidden" name="sort" value="{{sort}}">
                        <div class="wgFilterActions">
                            <noscript><button type="submit" class="wgBtn wgBtnPrimary wgBtnSmall">{{#t}}explore.apply{{/t}}</button></noscript>
                            <a class="wgBtn wgBtnGhost wgBtnSmall" href="/explore/{{slug}}" data-clear-filters data-testid="explore-clear">{{#t}}explore.clearFilters{{/t}}</a>
                        </div>
                    </form>
                </details>

                <section class="wgExploreResults">
                    <div class="wgExploreBar">
                        <p class="wgExploreCount" aria-live="polite" data-testid="explore-count" data-words="{{wordsJson}}">{{countLabel}}</p>
                        <label class="wgExploreSort">{{#t}}explore.sort{{/t}}
                            <select class="wgSelect" data-sort data-testid="explore-sort">
                                {{#sorts}}<option value="{{value}}" {{#on}}selected{{/on}}>{{label}}</option>{{/sorts}}
                            </select>
                        </label>
                    </div>
                    <ul class="wgGearGrid" id="wgGearResults" data-testid="explore-results">
                        {{#items}}
                        <li class="wgCard wgGearCard" data-testid="explore-item" data-id="{{id}}" data-cat="{{cat}}" data-type="{{type}}" data-brand="{{brandKey}}" data-weight="{{weight}}" data-price="{{priceValue}}" data-score="{{score}}" data-ratings="{{ratings}}" data-name="{{sortName}}" data-specs="{{specsJson}}" {{^shown}}hidden{{/shown}}>
                            <a href="/g/{{id}}" class="wgGearCardLink">
                                <span class="wgGearCardImg">{{#thumbUrl}}<img src="{{thumbUrl}}" alt="" loading="lazy" width="96" height="96">{{/thumbUrl}}{{^thumbUrl}}<span aria-hidden="true">{{initial}}</span>{{/thumbUrl}}</span>
                                <span class="wgGearCardBody">
                                    <span class="wgMuted wgGearCardBrand">{{brand}}{{#catName}} · {{catName}}{{/catName}}</span>
                                    <strong class="wgGearCardName">{{name}}</strong>
                                    <span class="wgGearCardFacts"><span class="wgMono">{{weightText}}</span>{{#priceText}} · {{priceText}}{{/priceText}}</span>
                                    {{#ratingCount}}<span class="wgGearCardRating" data-testid="explore-rating"><span class="wgStars" aria-hidden="true">{{ratingStars}}</span> <span class="wgVisuallyHidden">{{ratingLabel}}</span><span aria-hidden="true">{{ratingAvg}} ({{ratingCount}})</span></span>{{/ratingCount}}
                                    {{#keySpecs.length}}<span class="wgGearCardSpecs">{{#keySpecs}}<span>{{text}}</span>{{/keySpecs}}</span>{{/keySpecs.length}}
                                </span>
                            </a>
                        </li>
                        {{/items}}
                    </ul>
                    <p class="wgProfileEmpty" data-testid="explore-empty" {{#anyShown}}hidden{{/anyShown}}>{{#total}}{{#t}}explore.emptyFiltered{{/t}}{{/total}}{{^total}}{{#t}}explore.emptyCategory{{/t}}{{/total}}</p>
                </section>
            </div>
            {{/section}}
        </main>
        {{{scripts}}}
        {{> siteFooter}}
    </body>
</html>
