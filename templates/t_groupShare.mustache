<li class="wgGroupHead wgGroupHeadShare" data-group-id="{{id}}">
    <svg class="wgGroupIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
    <h2 class="wgGroupName">{{name}}</h2>
    <span class="wgGroupMeta">{{count}} {{countLabel}}</span>
    <span class="wgGroupWeight lpNumber"><span class="lpDisplaySubtotal" mg="{{weight}}">{{weightDisplay}}</span> <span class="wgMuted lpSubtotalUnit">{{unit}}</span></span>
</li>
