<li class="wgKitCard">
    <a href="/r/{{externalId}}" class="wgKitCardLink">
        <span class="wgKitCardName">{{name}}</span>
        <span class="wgKitCardWeight wgMono">{{baseWeight}}</span>
        <span class="wgKitCardMeta">{{weightClass}} · {{itemCount}}</span>
        {{#description}}<span class="wgKitCardDesc">{{description}}</span>{{/description}}
    </a>
</li>
