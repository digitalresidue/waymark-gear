# Copy to .env for local development. Every value here is optional; anything
# left unset falls back to config/default.json (and config/local.json if you
# have one). In Docker, set these as container environment variables instead.

# Postgres connection string. Overrides the pgDatabase block in config files.
DATABASE_URL=postgres://waymark:waymark@localhost:5432/waymark

# The public URL people reach the site on. Used in emailed links and embeds.
DEPLOY_URL=http://localhost:3000
PORT=3000

# Number of reverse proxies in front of the app (nginx = 1). Set 0 if the app
# is reachable directly, or clients can spoof their IP past the rate limiter.
# TRUST_PROXY=1

# "production" turns on secure cookies, HSTS and HTTPS upgrades.
# NODE_ENV=production

# Apply pending database migrations on startup (default true).
# MIGRATE_ON_START=true

# How long a sign-in lasts, in days (default 90).
# SESSION_DAYS=90

# Brute-force protection on sign-in, registration and password reset.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# RATE_LIMIT_AUTH_MAX=30

# Password-reset and forgot-username emails go through Mailgun.
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_API_KEY=
# MAIL_FROM="Waymark Gear <noreply@mg.example.com>"
# MAIL_REPLY_TO="Waymark Gear <hello@example.com>"

# Build-time (baked into the frontend by Vite):
# VITE_CONTACT_EMAIL=hello@example.com     shown in the footer and help; hidden if unset
# VITE_SOURCE_URL=https://github.com/you/waymark-gear   GPL source link in the footer

# JSON array of usernames allowed into /moderation.
# MODERATORS=["yourusername"]

# JSON array of site-owner usernames: manage the gear catalog and featured
# kits (and everything a moderator can do).
# ADMINS=["yourusername"]

# Sign in with Google. Create an OAuth client (Web application) in Google
# Cloud Console with redirect URI <DEPLOY_URL>/auth/google/callback.
# The Google button only appears when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Path to the cwebp binary used to convert uploaded photos (default: cwebp on PATH).
# CWEBP_PATH=/usr/bin/cwebp
