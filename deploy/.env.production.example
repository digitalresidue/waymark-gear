# Copy to /opt/waymark/.env on the server and fill in. Keep it private:
#   chmod 600 .env

# The image to run (published by GitHub Actions).
APP_IMAGE=ghcr.io/your-github-user/waymark-gear:latest

# Database password: long and random, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

DEPLOY_URL=https://waymarkgear.com

# Your username(s) once you've registered: catalog + featured kits.
ADMINS=["yourusername"]
MODERATORS=[]

# Google sign-in (see DEPLOY.md, step 4).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset email (see DEPLOY.md, step 5).
MAILGUN_DOMAIN=mg.waymarkgear.com
MAILGUN_API_KEY=
MAIL_FROM="Waymark Gear <noreply@mg.waymarkgear.com>"
MAIL_REPLY_TO="Waymark Gear <hello@waymarkgear.com>"

# Gear reviewers who aren't owners or moderators; OPEN_REVIEWS=true lets every member review.
REVIEWERS=[]
OPEN_REVIEWS=false

# Supporter plan through Stripe (see DEPLOY.md, "Supporter plan and affiliate links").
# Leave blank to keep subscriptions off; owners can still grant Supporter by hand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
SUPPORTER_MONTHLY_LABEL=$5
SUPPORTER_YEARLY_LABEL=$48
