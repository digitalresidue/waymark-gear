# Your site's settings. deploy/install.sh copies this to /opt/waymark/.env
# and fills in the first block for you; `waymark settings` opens it later.
# Keep it private (chmod 600): it holds passwords and keys.
# A line starting with # is a note and is ignored.

# Your domain, without https:// or www, e.g. waymarkgear.com.
SITE_DOMAIN=

# The version of Waymark to run (published by GitHub Actions).
APP_IMAGE=ghcr.io/digitalresidue/waymark-gear:latest

# Database password: long and random. Letters and digits only (it goes
# into a connection URL), e.g. `openssl rand -hex 24`. Set once; changing
# it later locks the app out of the existing database.
POSTGRES_PASSWORD=

# Site owners (manage the gear catalog, trails, featured kits). install.sh
# puts the account it creates here. JSON list: ["you","partner"].
ADMINS=["yourusername"]
MODERATORS=[]

# Google sign-in (see INSTALL.md, "Optional: Continue with Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset email (see INSTALL.md, "Recommended: email").
# Until these are set, "Forgot password" can't send anything.
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Gear reviewers who aren't owners or moderators; OPEN_REVIEWS=true lets every member review.
REVIEWERS=[]
OPEN_REVIEWS=false

# Supporter plan through Stripe (see DEPLOY.md, "Supporter plan and affiliate links").
# Leave blank to keep subscriptions off; owners can still grant Supporter by hand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
SUPPORTER_MONTHLY_LABEL=$5
SUPPORTER_YEARLY_LABEL=$48
