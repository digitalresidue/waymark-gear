# Caddy serves the site over HTTPS and renews its certificate automatically.
# The domain comes from SITE_DOMAIN in /opt/waymark/.env; both it and
# www.<domain> need to point at this server (see INSTALL.md, step 4).
# www.<domain> redirects to the plain domain.
#
# Cloudflare: with the orange cloud on, visitors reach Cloudflare and
# Cloudflare reaches this server. Trusting Cloudflare's addresses below lets
# Caddy pass the visitor's own IP on to the app (for the per-IP limits that
# hold off bots) instead of Cloudflare's. Anyone else's X-Forwarded-For is
# ignored, so it can't be forged, and nothing changes with the cloud grey.
# Cloudflare's published ranges (cloudflare.com/ips, updated 2023-09-28).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	encode zstd gzip
	reverse_proxy app:3000
}
