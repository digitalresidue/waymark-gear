{
    "name": "Waymark Gear",
    "short_name": "Waymark",
    "description": "Plan, weigh, pack and share your backpacking gear lists.",
    "id": "/",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#F5F6F2",
    "theme_color": "#1D3B30",
    "icons": [
        { "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/images/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/images/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Pack this list", "url": "/pack", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192" }] },
        { "name": "Gear closet", "url": "/gear", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192" }] }
    ]
}
