{
  "name": "waymark-gear",
  "version": "0.1.0",
  "description": "Waymark Gear: plan, weigh and share your backpacking gear lists. Forked from LighterPack.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env app.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env app.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed-sample": "node --env-file-if-exists=.env scripts/seed-sample-catalog.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:ui": "playwright test --ui",
    "test:visual": "VISUAL=1 playwright test visual --project=chromium",
    "test:visual:update": "VISUAL=1 playwright test visual --project=chromium --update-snapshots",
    "css:baseline": "node scripts/css-baseline.mjs save",
    "css:diff": "node scripts/css-baseline.mjs diff",
    "db:seed-demo": "node scripts/seed-demo.mjs"
  },
  "author": "",
  "license": "GPL-2.0",
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "config": "^5.0.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "formidable": "^3.5.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "marked": "^18.1.1",
    "mustache": "^4.2.0",
    "nanoid": "^5.1.7",
    "pg": "^8.23.1",
    "satori": "^0.63.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "dragula": "^3.7.3",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.0.0",
    "sass": "^1.106.1",
    "vite": "^8.0.8",
    "vue": "^3.5.13",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "fflate": "^0.8.2"
  }
}
